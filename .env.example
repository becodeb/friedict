# ============================================================================
# Cantado — variables de entorno
# ----------------------------------------------------------------------------
# Copiá este archivo a `.env.local` y completá los valores de tu proyecto.
#
# TODO lo que empieza con VITE_ termina DENTRO del bundle que se descarga el
# navegador. No es un secreto: es contenido público. Por eso acá sólo puede
# vivir la clave anónima / publicable de Supabase, que está diseñada para
# exponerse y que sin RLS no sirve de nada.
#
# La `service_role` key NUNCA va acá, ni con otro nombre, ni "sólo para
# probar". Salteás toda la seguridad de la base con solo abrir DevTools.
# ============================================================================

# URL de la API de tu proyecto Supabase.
#   · Local (supabase start):  http://127.0.0.1:54421
#   · Nube:                    https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Clave anónima (anon / publishable). La imprime `supabase status`, o está en
# el panel del proyecto → Settings → API.
VITE_SUPABASE_ANON_KEY=
