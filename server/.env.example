# ============================================================================
# friedict — servidor
# ----------------------------------------------------------------------------
# Copiá a `server/.env` para desarrollo. En producción estas variables las
# inyecta Coolify.
# ============================================================================

NODE_ENV=development
PORT=8183

# Superusuario: sólo para migraciones y para crear el rol de la app.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54432/friedict

# El rol con el que se atienden las peticiones. NO es superusuario y NO es
# dueño de las tablas: si lo fuera, Postgres le saltearía la RLS y toda la
# seguridad del producto quedaría en la nada.
DATABASE_URL=postgresql://friedict_app:friedict_app@127.0.0.1:54432/friedict

# Firma las cookies de sesión. Generá uno con `openssl rand -base64 48`.
JWT_SECRET=cambiame-por-uno-largo-de-verdad-al-menos-32-caracteres

# Carga db/seed.sql al arrancar si la base está vacía. Sólo para pruebas.
SEED_ON_BOOT=0

# Ingreso con Google (opcional). Sin esto, sólo se puede entrar con contraseña.
# El callback que hay que autorizar en Google Cloud Console es
# <PUBLIC_ORIGIN>/api/auth/google/callback
# PUBLIC_ORIGIN=https://friedict.becode.com.ar
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
